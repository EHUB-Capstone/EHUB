      <_Parameter1>EHub.Api, Version=1.0.0.0, Culture=neutral, PublicKeyToken=null</_Parameter1>
      <_Parameter2>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../../../backend/src/EHub.Api'))</_Parameter2>
      <_Parameter3>EHub.Api.csproj</_Parameter3>
      <_Parameter4>0</_Parameter4>
