# Safe template only. Copy to .env.staging in /opt/ehub/staging/app on the VPS.
# Replace placeholders privately; never copy production secrets or commit the real file.
# Project, image names, network, volume and loopback port 3001 are fixed in Compose.

# Use the full reviewed commit SHA from: git rev-parse HEAD
IMAGE_TAG=replace-with-reviewed-full-git-sha

# PostgreSQL staging. Generate an independent password with: openssl rand -hex 32
POSTGRES_DB=ehub_staging_db
POSTGRES_USER=ehub_staging_app
POSTGRES_PASSWORD=replace-with-staging-random-hex-password

# Generate each secret independently with: openssl rand -hex 64
JWT_ISSUER=EHub.Api.Staging
JWT_AUDIENCE=EHub.Web.Staging
JWT_SECRET=replace-with-staging-random-128-character-hex-value
REGISTRATION_OTP_HASH_KEY=replace-with-another-staging-random-128-character-hex-value

# Separate Web application client; allow https://staging.e-hub.com.vn in Google.
# This public ID is used both by the API and at frontend build time.
GOOGLE_CLIENT_ID=replace-with-staging-google-web-client-id.apps.googleusercontent.com

# Working SMTP is required in Staging. Use staging credentials and team test recipients.
EMAIL_FROM_NAME="EHUB Staging"
EMAIL_FROM_EMAIL=replace-with-staging-verified-sender-email
EMAIL_SMTP_HOST=replace-with-staging-smtp-host
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=replace-with-staging-smtp-username
EMAIL_PASSWORD=replace-with-staging-smtp-password
EMAIL_SECURE_SOCKET_OPTION=StartTls

# Optional fallback. If enabled, fill ALL three blank fields using staging credentials.
EMAIL_ENABLE_BREVO_FALLBACK=false
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SECURE_SOCKET_OPTION=StartTls
BREVO_FROM_NAME="EHUB Staging"
BREVO_FROM_EMAIL=
BREVO_SMTP_USERNAME=
BREVO_SMTP_PASSWORD=

# Separate Cloudinary cloud/product environment for staging images.
CLOUDINARY_CLOUD_NAME=replace-with-staging-cloud-name
CLOUDINARY_API_KEY=replace-with-staging-api-key
CLOUDINARY_API_SECRET=replace-with-staging-api-secret

# Private R2 bucket and Object Read & Write token scoped ONLY to this staging bucket.
# Add https://staging.e-hub.com.vn to its CORS policy. Never put these in VITE_*.
R2_ACCOUNT_ID=replace-with-cloudflare-account-id
R2_ACCESS_KEY_ID=replace-with-staging-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-staging-r2-secret-access-key
R2_BUCKET_NAME=ehub-submissions-staging

# First initialization only. Store the password privately and clear this field after seeding.
ADMIN_SEED_EMAIL=replace-with-staging-admin-email
ADMIN_SEED_PASSWORD=replace-with-staging-strong-one-time-password
ADMIN_SEED_FULL_NAME="EHUB Staging Administrator"

# Keep release switches aligned with the production version being verified.
VITE_FEATURE_AI=true
VITE_FEATURE_CHAT=true
VITE_FEATURE_DATA_BANK=true
VITE_FEATURE_EVALUATIONS=true
VITE_FEATURE_MENTORING=true
VITE_FEATURE_RANKINGS=true
VITE_FEATURE_ROLE_DASHBOARDS=true
VITE_FEATURE_STARTUP_IDEAS=true
VITE_FEATURE_WORKSHOPS=true

VITE_FEATURE_CLASS_RENAME=false
VITE_FEATURE_CLASS_LIFECYCLE=true
VITE_FEATURE_CLASS_MAJOR_VERIFICATION=true
VITE_FEATURE_CLASS_MENTOR_ASSIGNMENT=true
VITE_FEATURE_CLASS_TEAM_MANAGEMENT=true
VITE_FEATURE_CLASS_CHAT_BACKFILL=false
VITE_FEATURE_CLASS_PROJECT_DIRECTION=true
VITE_FEATURE_CLASS_STUDENT_SELF_SERVICE=true
VITE_FEATURE_CLASS_LECTURER_STUDENT_IMPORT=true
