# Safe-to-commit key-name reference only. Keep placeholder values in this
# file. ASP.NET Core reads real values from .NET user secrets locally and from
# the hosting provider's environment-variable/secret settings in staging.

# Runtime
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080

# PostgreSQL / Npgsql
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=ehub_db;Username=ehub_user;Password=replace-me

# JWT (the secret must contain at least 32 characters; use a random 64-byte
# value outside local development)
Jwt__Issuer=EHub.Api
Jwt__Audience=EHub.Web
Jwt__Secret=replace-with-a-long-random-secret-at-least-32-characters
Jwt__AccessTokenExpirationMinutes=30
Jwt__RefreshTokenExpirationDays=7

# Google Identity Services
Google__ClientId=replace-with-google-client-id.apps.googleusercontent.com

# Browser origin and password-reset URL
Cors__AllowedOrigins__0=http://localhost:5173
Frontend__BaseUrl=http://localhost:5173
PasswordReset__TokenExpirationMinutes=15

# Render terminates public HTTPS traffic at its managed reverse proxy before
# forwarding it to this container. Keep this disabled for direct local runs.
ReverseProxy__Enabled=false

# Email. Console is safe for local/staging bootstrap. SMTP credentials must be
# stored as hosting secrets when SMTP is enabled.
Email__Provider=Console
Email__FromName=EHUB
Email__FromEmail=noreply@ehub.local
# Email__SmtpHost=smtp.gmail.com
# Email__SmtpPort=587
# Email__Username=replace-with-smtp-username
# Email__Password=replace-with-smtp-app-password
# Email__SecureSocketOption=StartTls

# Optional idempotent admin bootstrap for --initialize-database.
# Remove the password from the hosting environment after initialization.
AdminSeed__Email=admin.staging@example.com
AdminSeed__Password=replace-with-a-strong-one-time-password
AdminSeed__FullName=EHUB Staging Admin

# Optional Gemini matching. Local dotnet runs use User Secrets, not this file automatically.
# See scripts/mentoring/configure-gemini.ps1 and docs/deployment/GEMINI_MENTOR_VPS.md.
# Mentoring__MatchingProvider=Gemini
# Mentoring__Gemini__ApiKey=replace-with-key-in-secret-store
# Mentoring__Gemini__Model=gemini-3.5-flash-lite
# Mentoring__Gemini__FallbackModels=gemini-3.1-flash-lite
# Mentoring__Gemini__DataTransferEnabled=false
# Scoring: 80 profile + 10 history + 10 achievements, calculated by backend from five AI criteria.
# Mentoring__Scoring__ExperienceWeight=35
# Mentoring__Scoring__ExpertiseWeight=25
# Mentoring__Scoring__StartupDomainWeight=15
# Mentoring__Scoring__TechnologyWeight=20
# Mentoring__Scoring__BioWeight=5
