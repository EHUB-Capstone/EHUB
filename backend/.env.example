# Database Configuration (PostgreSQL Docker Local)
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=ehub_db
DB_USERNAME=ehub_user
DB_PASSWORD=ehub_password

# Connection string template (used in appsettings.json)
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=ehub_db;Username=ehub_user;Password=ehub_password

# JWT Authentication Config
JwtSettings__Secret=super_secret_key_minimum_32_characters_long_for_security_baseline_12345!
JwtSettings__Issuer=EHubAPI
JwtSettings__Audience=EHubClient
JwtSettings__ExpiryMinutes=15
JwtSettings__RefreshTokenExpiryDays=7

# Cloudinary Config
Cloudinary__CloudName=your_cloud_name
Cloudinary__ApiKey=your_api_key
Cloudinary__ApiSecret=your_api_secret

# CORS Config
Cors__AllowedOrigins=http://localhost:5173
