{
  "Serilog": {
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/ehub-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ]
  },
  "Frontend": {
    "BaseUrl": "http://localhost:5173",
    "EmailBaseUrl": "https://staging.e-hub.com.vn"
  },
  "PasswordReset": {
    "TokenExpirationMinutes": 15
  },
  "Email": {
    "Provider": "Smtp",
    "FromName": "EHUB",
    "FromEmail": "fptsmep@gmail.com",
    "SmtpHost": "smtp.gmail.com",
    "SmtpPort": 587,
    "SecureSocketOption": "StartTls"
  }
}
