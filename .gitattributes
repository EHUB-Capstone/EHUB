# Staging scripts must remain executable by Bash after checkout on Windows or Linux.
/scripts/staging/*.sh text eol=lf
# Production operational scripts and systemd units run on Linux and must keep LF endings.
/scripts/production/*.sh text eol=lf
/deploy/systemd/* text eol=lf
# Preserve model bytes and its checksum across Windows and Linux checkouts.
/backend/src/EHub.Infrastructure/Mentoring/Models/allocation-model.json -text whitespace=cr-at-eol
