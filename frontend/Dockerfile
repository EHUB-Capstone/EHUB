FROM node:22-alpine AS build
WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .

ARG VITE_GOOGLE_CLIENT_ID
ARG VITE_ENABLE_API_MOCKS=false
ARG VITE_ENABLE_REALTIME=false
ARG VITE_REALTIME_ORIGIN
ARG VITE_FEATURE_AI=true
ARG VITE_FEATURE_CHAT=true
ARG VITE_FEATURE_DATA_BANK=true
ARG VITE_FEATURE_EVALUATIONS=true
ARG VITE_FEATURE_MENTORING=true
ARG VITE_FEATURE_RANKINGS=true
ARG VITE_FEATURE_ROLE_DASHBOARDS=true
ARG VITE_FEATURE_STARTUP_IDEAS=true
ARG VITE_FEATURE_WORKSHOPS=true
ARG VITE_FEATURE_CLASS_RENAME=false
ARG VITE_FEATURE_CLASS_LIFECYCLE=true
ARG VITE_FEATURE_CLASS_MAJOR_VERIFICATION=true
ARG VITE_FEATURE_CLASS_MENTOR_ASSIGNMENT=true
ARG VITE_FEATURE_CLASS_TEAM_MANAGEMENT=true
ARG VITE_FEATURE_CLASS_CHAT_BACKFILL=false
ARG VITE_FEATURE_CLASS_PROJECT_DIRECTION=true
ARG VITE_FEATURE_CLASS_STUDENT_SELF_SERVICE=true
ARG VITE_FEATURE_CLASS_LECTURER_STUDENT_IMPORT=true
ARG VITE_SHOW_UNAVAILABLE_CLASS_FEATURES=false

ENV VITE_GOOGLE_CLIENT_ID=$VITE_GOOGLE_CLIENT_ID
ENV VITE_ENABLE_API_MOCKS=$VITE_ENABLE_API_MOCKS
ENV VITE_ENABLE_REALTIME=$VITE_ENABLE_REALTIME
ENV VITE_REALTIME_ORIGIN=$VITE_REALTIME_ORIGIN
ENV VITE_FEATURE_AI=$VITE_FEATURE_AI
ENV VITE_FEATURE_CHAT=$VITE_FEATURE_CHAT
ENV VITE_FEATURE_DATA_BANK=$VITE_FEATURE_DATA_BANK
ENV VITE_FEATURE_EVALUATIONS=$VITE_FEATURE_EVALUATIONS
ENV VITE_FEATURE_MENTORING=$VITE_FEATURE_MENTORING
ENV VITE_FEATURE_RANKINGS=$VITE_FEATURE_RANKINGS
ENV VITE_FEATURE_ROLE_DASHBOARDS=$VITE_FEATURE_ROLE_DASHBOARDS
ENV VITE_FEATURE_STARTUP_IDEAS=$VITE_FEATURE_STARTUP_IDEAS
ENV VITE_FEATURE_WORKSHOPS=$VITE_FEATURE_WORKSHOPS
ENV VITE_FEATURE_CLASS_RENAME=$VITE_FEATURE_CLASS_RENAME
ENV VITE_FEATURE_CLASS_LIFECYCLE=$VITE_FEATURE_CLASS_LIFECYCLE
ENV VITE_FEATURE_CLASS_MAJOR_VERIFICATION=$VITE_FEATURE_CLASS_MAJOR_VERIFICATION
ENV VITE_FEATURE_CLASS_MENTOR_ASSIGNMENT=$VITE_FEATURE_CLASS_MENTOR_ASSIGNMENT
ENV VITE_FEATURE_CLASS_TEAM_MANAGEMENT=$VITE_FEATURE_CLASS_TEAM_MANAGEMENT
ENV VITE_FEATURE_CLASS_CHAT_BACKFILL=$VITE_FEATURE_CLASS_CHAT_BACKFILL
ENV VITE_FEATURE_CLASS_PROJECT_DIRECTION=$VITE_FEATURE_CLASS_PROJECT_DIRECTION
ENV VITE_FEATURE_CLASS_STUDENT_SELF_SERVICE=$VITE_FEATURE_CLASS_STUDENT_SELF_SERVICE
ENV VITE_FEATURE_CLASS_LECTURER_STUDENT_IMPORT=$VITE_FEATURE_CLASS_LECTURER_STUDENT_IMPORT
ENV VITE_SHOW_UNAVAILABLE_CLASS_FEATURES=$VITE_SHOW_UNAVAILABLE_CLASS_FEATURES

RUN npm run build

FROM nginx:1.27-alpine AS runtime

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
