VITE_API_BASE_URL=http://localhost:5226/api
VITE_GOOGLE_CLIENT_ID=replace-with-google-client-id.apps.googleusercontent.com

# Frontend-only mock API for the post-2026-07-22 modules. Unmatched requests
# still pass through to the real backend (for example, authentication).
VITE_ENABLE_API_MOCKS=false

# Class-management safety flags. Keep disabled until the corresponding backend
# contract, authorization and regression tests are production-ready.
VITE_FEATURE_CLASS_RENAME=false
VITE_FEATURE_CLASS_LIFECYCLE=false
VITE_FEATURE_CLASS_MAJOR_VERIFICATION=false
VITE_FEATURE_CLASS_MENTOR_ASSIGNMENT=false
VITE_FEATURE_CLASS_TEAM_MANAGEMENT=false
VITE_FEATURE_CLASS_CHAT_BACKFILL=false
VITE_FEATURE_CLASS_CODE_CONFLICT_REPORT=false
VITE_FEATURE_CLASS_PROJECT_DIRECTION=false
VITE_FEATURE_CLASS_STUDENT_SELF_SERVICE=false
VITE_FEATURE_CLASS_LECTURER_STUDENT_IMPORT=true
VITE_SHOW_UNAVAILABLE_CLASS_FEATURES=false
