# Safe-to-commit frontend template only. Never put passwords, connection
# strings, private keys, or server-side tokens in VITE_* variables because
# Vite embeds them in the browser bundle.

# REST requests always use the same-origin /api path. Vite proxies that path
# locally and Vercel proxies it to the staging backend after deployment.
VITE_GOOGLE_CLIENT_ID=replace-with-google-client-id.apps.googleusercontent.com

# The ASP.NET backend in this repository does not expose Socket.IO. Keep this
# disabled unless a compatible realtime service is deployed explicitly.
VITE_ENABLE_REALTIME=false
# VITE_REALTIME_ORIGIN=https://replace-with-realtime-origin.example.com

# Frontend-only mock API for the post-2026-07-22 modules. Unmatched requests
# still pass through to the real backend (for example, authentication).
VITE_ENABLE_API_MOCKS=false

# Pilot page visibility switches. The team wants these pages visible without a
# development badge. Set an individual value to false only when a production
# issue requires that page to be removed from navigation temporarily.
VITE_FEATURE_AI=true
VITE_FEATURE_CHAT=true
VITE_FEATURE_DATA_BANK=true
VITE_FEATURE_EVALUATIONS=true
VITE_FEATURE_MENTORING=true
VITE_FEATURE_RANKINGS=true
VITE_FEATURE_ROLE_DASHBOARDS=true
VITE_FEATURE_STARTUP_IDEAS=true
VITE_FEATURE_WORKSHOPS=true

# Class-management feature flags. Keep every staging value explicit so a
# frontend deployment cannot accidentally expose a workflow by default.
VITE_FEATURE_CLASS_RENAME=false
VITE_FEATURE_CLASS_LIFECYCLE=true
VITE_FEATURE_CLASS_MAJOR_VERIFICATION=true
VITE_FEATURE_CLASS_MENTOR_ASSIGNMENT=true
VITE_FEATURE_CLASS_TEAM_MANAGEMENT=true
VITE_FEATURE_CLASS_CHAT_BACKFILL=false
VITE_FEATURE_CLASS_PROJECT_DIRECTION=true
VITE_FEATURE_CLASS_STUDENT_SELF_SERVICE=true
VITE_FEATURE_CLASS_LECTURER_STUDENT_IMPORT=true
VITE_SHOW_UNAVAILABLE_CLASS_FEATURES=false
