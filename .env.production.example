# Safe production template. Copy this file to .env.production on the VPS,
# replace every placeholder there, and keep that real file outside Git.

# Immutable release identification
IMAGE_TAG=replace-with-reviewed-git-sha
BACKEND_IMAGE=ehub-backend
FRONTEND_IMAGE=ehub-frontend
FRONTEND_HOST_PORT=3000

# PostgreSQL. Generate POSTGRES_PASSWORD with: openssl rand -hex 32
POSTGRES_DB=ehub_db
POSTGRES_USER=ehub_app
POSTGRES_PASSWORD=replace-with-random-hex-password

# JWT and registration OTP must use two independent random values.
# Generate each with: openssl rand -hex 64
JWT_ISSUER=EHub.Api.Production
JWT_AUDIENCE=EHub.Web.Production
JWT_SECRET=replace-with-random-128-character-hex-value
REGISTRATION_OTP_HASH_KEY=replace-with-a-different-random-128-character-hex-value

# Google Identity Services. This identifier is public and is embedded in the
# frontend bundle; the matching Google configuration must allow e-hub.com.vn.
GOOGLE_CLIENT_ID=replace-with-google-web-client-id.apps.googleusercontent.com

# Transactional SMTP
EMAIL_FROM_NAME=EHUB
EMAIL_FROM_EMAIL=replace-with-sender-email
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=replace-with-smtp-username
EMAIL_PASSWORD=replace-with-smtp-app-password
EMAIL_SECURE_SOCKET_OPTION=StartTls

# Brevo SMTP fallback
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SECURE_SOCKET_OPTION=StartTls
BREVO_FROM_NAME=EHUB
BREVO_FROM_EMAIL=replace-with-verified-brevo-sender
BREVO_SMTP_USERNAME=replace-with-brevo-smtp-login
BREVO_SMTP_PASSWORD=replace-with-brevo-smtp-key
EMAIL_ENABLE_BREVO_FALLBACK=true

# Cloudinary server-side credentials (avatars and submission files uploaded before R2).
# API_SECRET must never use a VITE_ prefix.
CLOUDINARY_CLOUD_NAME=replace-with-cloud-name
CLOUDINARY_API_KEY=replace-with-api-key
CLOUDINARY_API_SECRET=replace-with-api-secret

# Cloudflare R2 private bucket for submission documents (S3-compatible API).
# Use an API token limited to this bucket with Object Read & Write. Never use a VITE_ prefix.
R2_ACCOUNT_ID=replace-with-cloudflare-account-id
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
R2_BUCKET_NAME=replace-with-private-bucket-name

# Optional one-time administrator bootstrap. Clear ADMIN_SEED_PASSWORD from the
# VPS file immediately after the first successful database initialization.
ADMIN_SEED_EMAIL=replace-with-initial-admin-email
ADMIN_SEED_PASSWORD=replace-with-strong-one-time-password
ADMIN_SEED_FULL_NAME=EHUB Administrator

# Pilot page visibility. These pages remain visible by the team's decision,
# while API mocks and realtime transport remain disabled in production.
VITE_FEATURE_AI=true
VITE_FEATURE_CHAT=true
VITE_FEATURE_DATA_BANK=true
VITE_FEATURE_EVALUATIONS=true
VITE_FEATURE_MENTORING=true
VITE_FEATURE_RANKINGS=true
VITE_FEATURE_ROLE_DASHBOARDS=true
VITE_FEATURE_STARTUP_IDEAS=true
VITE_FEATURE_WORKSHOPS=true

# Class-management release switches
VITE_FEATURE_CLASS_RENAME=false
VITE_FEATURE_CLASS_LIFECYCLE=true
VITE_FEATURE_CLASS_MAJOR_VERIFICATION=true
VITE_FEATURE_CLASS_MENTOR_ASSIGNMENT=true
VITE_FEATURE_CLASS_TEAM_MANAGEMENT=true
VITE_FEATURE_CLASS_CHAT_BACKFILL=false
VITE_FEATURE_CLASS_PROJECT_DIRECTION=true
VITE_FEATURE_CLASS_STUDENT_SELF_SERVICE=true
VITE_FEATURE_CLASS_LECTURER_STUDENT_IMPORT=true

# AI mentor-matching provider. Read by the deploy script, not by Compose.
MENTOR_MATCHING_PROVIDER=Gemini

# Gemini: use docker-compose.gemini.yml (deploy script selects it for provider Gemini).
# Set the real key only in the VPS secret store; never expose it as VITE_*.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite
# Enable only after reviewing the minimized professional text; masking cannot guarantee anonymity.
GEMINI_DATA_TRANSFER_ENABLED=false
GEMINI_MINIMUM_REQUEST_INTERVAL_SECONDS=12
# Backend scoring: 70 profile + 15 history + 15 achievements; no overall AI score.
MENTOR_RULE_EXPERIENCE_WEIGHT=35
MENTOR_RULE_EXPERTISE_WEIGHT=25
MENTOR_RULE_STARTUP_DOMAIN_WEIGHT=15
MENTOR_RULE_TECHNOLOGY_WEIGHT=20
MENTOR_RULE_BIO_WEIGHT=5

# AI checkpoint summaries. Off for go-live: no AI card on the screen and no background work.
# To switch on: set Ollama and run the deploy script (it starts ollama and pulls the model);
# set Disabled and deploy again to switch off. See docs/workspace/AI_CHECKPOINT_SUMMARY.md.
CHECKPOINT_SUMMARY_PROVIDER=Disabled
