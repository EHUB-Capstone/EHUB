# Safe-to-commit template only. Keep placeholder values in this file.
# Put real local values in an ignored .env file and cloud values in the
# hosting provider's environment-variable/secret settings.

# JWT Configuration
JWT_SECRET=replace-with-long-random-secret-at-least-64-characters

# Google OAuth Configuration
GOOGLE_CLIENT_ID=replace-with-google-client-id.apps.googleusercontent.com

# Optional local SMTP configuration used by docker-compose.local.yml
EMAIL_USERNAME=replace-with-smtp-username
EMAIL_PASSWORD=replace-with-smtp-app-password
