[Unit]
Description=EHUB PostgreSQL backup to Cloudflare R2
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/ehub/app
ExecStart=/bin/bash /opt/ehub/app/scripts/production/backup-and-upload.sh production run
TimeoutStartSec=1800
Nice=10
IOSchedulingClass=idle
