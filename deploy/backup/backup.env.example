# Safe template for the automated PostgreSQL backup job. Copy this file to
# /opt/ehub/backup.env on the production VPS, replace every placeholder there,
# then run: sudo chown root:root /opt/ehub/backup.env && sudo chmod 600 /opt/ehub/backup.env
# The real file stays outside Git and is separate from .env.production.

# Dedicated Cloudflare R2 bucket for database backups. This must NOT be the
# submission-files bucket, and the token below must be scoped to this bucket only.
R2_ACCOUNT_ID=replace-with-cloudflare-account-id
R2_BACKUP_BUCKET=ehub-db-backups
R2_BACKUP_ACCESS_KEY_ID=replace-with-bucket-scoped-access-key-id
R2_BACKUP_SECRET_ACCESS_KEY=replace-with-bucket-scoped-secret-access-key

# Discord webhook of the private operations channel. Anyone who has this URL can
# post to the channel, so treat it as a secret.
DISCORD_WEBHOOK_URL=replace-with-ops-channel-webhook-url

# Optional policy values; the scripts default to these numbers when the lines are absent.
# Retention on R2 (30 days) is enforced by the bucket lifecycle rule, not by this file.
BACKUP_MAX_AGE_HOURS=26
DISK_ALERT_PERCENT=75
